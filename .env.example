# Google Ads
GOOGLE_ADS_CUSTOMER_ID=1234567890

# BigQuery
BQ_PROJECT_ID=your-gcp-project-id
BQ_DATASET_ID=your_dataset

# Anthropic (for keyword generation in sync_articles_to_ads.py)
ANTHROPIC_API_KEY=sk-ant-...

# Discord Webhook (optional — alerts and weekly summaries)
DISCORD_WEBHOOK_AD_ALERT=https://discord.com/api/webhooks/...

# Content repository path (for sync_articles_to_ads.py)
# Defaults to ~/content-repo if not set
CONTENT_REPO_PATH=/path/to/your/content-repo

# Site base URL (used in config.py)
SITE_BASE_URL=https://example.org
